[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=OwnTerm
GenericName=TerminalEmulator

Exec=ownterm %U
StartupWMClass=dev.ownterm.OwnTerm

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.ownterm.OwnTerm

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for ownterm:// URLs.
MimeType=x-scheme-handler/ownterm;
