# Copy values into the environment or into ~/.ownterm/provider.env.
# Never commit a real API key. provider.env must not contain api_key.
# Presets: ollama, lmstudio, vllm, localai, openai, xai, openrouter, groq, compatible
OWNTERM_PROVIDER=ollama
OWNTERM_BASE_URL=
OWNTERM_MODEL=llama3.3
OWNTERM_API_KEY=
